# Normalise line endings so the project behaves the same on Windows, macOS and Linux.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf

# Binary files: never touch line endings, never diff.
*.tflite binary
*.keras binary
*.h5 binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
*.ttf binary
*.otf binary
